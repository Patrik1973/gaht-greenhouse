9d6c","version":3,"exposeAsEntityConfig":"","updateInterval":"1","updateIntervalType":"num","updateIntervalUnits":"minutes","outputInitially":true,"outputOnChanged":false,"entityId":"switch.greenhouse_fan_on_off","stateType":"str","ifState":"","ifStateType":"str","ifStateOperator":"is","outputs":1,"outputProperties":[{"property":"payload","propertyType":"msg","value":"string","valueType":"entityState"},{"property":"data","propertyType":"msg","value":"","valueType":"entity"},{"property":"topic","propertyType":"msg","value":"","valueType":"triggerId"}],"x":140,"y":820,"wires":[["c373c6cf4213831c","c89cb3df259b4ef4"]]},{"id":"c89cb3df259b4ef4","type":"change","z":"e4ba79612189d63e","name":"AddTopic3","rules":[{"t":"change","p":"topic","pt":"msg","from":"switch.greenhouse_fan_on_off","fromt":"str","to":"ventilatoronoff","tot":"str"}],"action":"","property":"","from":"","to":"","reg":false,"x":150,"y":880,"wires":[["e9230256d23286e9"]]},{"id":"a644f07d36945087","type":"time-range-switch","z":"e4ba79612189d63e","name":"Sunrise/Sunset","lat":"49.54062","lon":"15.66464","startTime":"sunrise","endTime":"sunset","startOffset":"60","endOffset":"-30","x":420,"y":780,"wires":[["d3fb4a20dc48eaee"],["566ede35824f494f"]]},{"id":"566ede35824f494f","type":"function","z":"e4ba79612189d63e","name":"NOC - Hystereze ohřev skleníku/chlazení půdy","func":"// Načtení teplot pro noční ohřev skleníku z půdy\nvar flAir = parseFloat(msg.payload.teplotasklenik);\nvar flSoil = parseFloat(msg.payload.teplotapudavstup);\nvar fantemp = String(msg.payload.ventilatoronoff).toLowerCase().trim();\nvar boolFan = (fantemp === \"on\");  // zjisteni zda je ventilator zapnuty/vypnuty\n\nvar diff = flSoil - flAir;\n\n// Nastavení minimální pauzy po vypnutí\nconst MIN_PAUSE_MS = 10 * 60 * 1000; // 10 minut\nlet now = Date.now();\nlet lastOff = context.get(\"lastOff\") || 0;\nlet canStart = (now - lastOff) >= MIN_PAUSE_MS;\n\n// Konstanty\n//const HEAT_DIFF_OFF = 3;     // vypnout, když rozdíl klesne na 3 °C\n\n\nconst month = new Date().getMonth() + 1;\n\nlet HEAT_ON_AIR;\nlet HEAT_OFF_AIR;\nlet HEAT_MIN_SOIL;\nlet HEAT_DIFF_ON;\nlet HEAT_DIFF_OFF;\n\nif (month >= 5 && month <= 9) {\n    // léto\n    HEAT_ON_AIR = 8;\n    HEAT_OFF_AIR = 11;\n    HEAT_MIN_SOIL = 10;\n    HEAT_DIFF_ON = 5;\n    HEAT_DIFF_OFF = 3;\n} else {\n    // zima\n    HEAT_ON_AIR = 5;\n    HEAT_OFF_AIR = 6;\n    HEAT_MIN_SOIL = 5;\n    HEAT_DIFF_ON = 4;\n    HEAT_DIFF_OFF = 2;\n}\n\n\n\n// Zapnout noční ohřev\nif (!boolFan && flAir <= HEAT_ON_AIR && flSoil >= HEAT_MIN_SOIL && diff >= HEAT_DIFF_ON) {\n    msg.payload = true; //zapni ventilator\n    //msg.topic = \"fan\";\n    return msg;\n}\n\n// Vypnout noční ohřev\nif (boolFan && (flAir >= HEAT_OFF_AIR || flSoil < HEAT_MIN_SOIL || diff <= HEAT_DIFF_OFF)) {\n    msg.payload = false;\n    context.set(\"lastOff\", now);\n    //msg.topic = \"fan\";\n    return msg;\n}\n\n// Když běží ventilátor a pořád má smysl topit,\n// pošli true kvůli resetu případného triggeru\nif (boolFan && flAir < HEAT_OFF_AIR && flSoil >= HEAT_MIN_SOIL && diff > HEAT_DIFF_OFF) {\n    msg.payload = true;\n    //msg.topic = \"fan\";\n    return msg;\n}\n\n// nic neposílej\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":600,"y":860,"wires":[["208d25c7f230ea47","cbd43233644f57e4"]]},{"id":"a9970af9980e366c","type":"comment","z":"e4ba79612189d63e","name":"Hystereze DEN / NOC - ventilátor ve skleníku","info":"DEN\nNOC","x":210,"y":360,"wires":[]},{"id":"208d25c7f230ea47","type":"debug","z":"e4ba79612189d63e","name":"debug 85","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"false","statusVal":"","statusType":"auto","x":620,"y":920,"wires":[]},{"id":"61f89108.a9d6c","type":"server","name":"Home Assistant Main","version":6,"addon":true,"rejectUnauthorizedCerts":true,"ha_boolean":["y","yes","true","on","home","open"],"connectionDelay":true,"cacheJson":true,"heartbeat":false,"heartbeatInterval":30,"areaSelector":"fri