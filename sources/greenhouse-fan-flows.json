th() + 1;\n\nlet COOL_ON;\nlet COOL_OFF;\n\nif (month >= 5 && month <= 9) {\n    // léto\n    COOL_ON = 24;\n    COOL_OFF = 22;\n} else {\n    // zima\n    COOL_ON = 16;\n    COOL_OFF = 14;\n}\n\n// Chlazeni skleniku během dne\nif ((!boolFan && flAir >= COOL_ON) ) {\n    msg.payload = true; //zapni ventilator\n    //msg.topic = \"fan\";\n    return msg;\n\n}\nelse if (boolFan && flAir <= COOL_OFF) {\n    msg.payload = false; //vypni ventilator\n    context.set(\"lastOff\", now);\n    //msg.topic = \"fan\";\n    return msg;\n\n}\n\n\n// Ventilátor běží a teplota je zase nad vypínací hranicí\n// tím zrušíme případné čekající vypnutí\nif (boolFan && flAir > COOL_OFF) {\n    msg.payload = true;\n    //msg.topic = \"fan\";\n    return msg;\n}\n\n\n// mezi 22–24 °C → nic neposílej\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":600,"y":720,"wires":[["cbd43233644f57e4","6fd48ca3e0ae454b"]]},{"id":"cbd43233644f57e4","type":"switch","z":"e4ba79612189d63e","name":"Ventilátor - Zap/Vyp","property":"payload","propertyType":"msg","rules":[{"t":"true"},{"t":"false"}],"checkall":"true","repair":false,"outputs":2,"x":720,"y":800,"wires":[["c80855e8fc817ac7"],["16464833b85e747d"]],"inputLabels":["T1"]},{"id":"e2a85b695fbc8816","type":"api-call-service","z":"e4ba79612189d63e","name":"","server":"61f89108.a9d6c","version":7,"debugenabled":false,"action":"switch.turn_on","floorId":[],"areaId":[],"deviceId":[],"entityId":["switch.greenhouse_fan_on_off"],"labelId":[],"data":"","dataType":"jsonata","mergeContext":"","mustacheAltTags":false,"outputProperties":[],"queue":"none","blockInputOverrides":true,"domain":"switch","service":"turn_on","x":1240,"y":760,"wires":[[]]},{"id":"c6523f77e5d8ea58","type":"api-call-service","z":"e4ba79612189d63e","name":"","server":"61f89108.a9d6c","version":7,"debugenabled":false,"action":"switch.turn_off","floorId":[],"areaId":[],"deviceId":[],"entityId":["switch.greenhouse_fan_on_off"],"labelId":[],"data":"","da